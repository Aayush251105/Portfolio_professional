# Contact form (app/api/contact/route.ts). Copy to .env.local and fill in; set the same vars in Vercel.
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where contact form messages are delivered
CONTACT_TO_EMAIL=
# Optional: sender on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# If unset, Resend's onboarding sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional: canonical site URL for SEO tags, sitemap and link previews (e.g. https://aayushgupta.dev).
# On Vercel the production domain is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=
